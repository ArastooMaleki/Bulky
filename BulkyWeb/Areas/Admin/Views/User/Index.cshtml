@model BulkyWeb.Areas.Admin.ViewModels.ApplicationUserIndex
@{
    ViewData["Title"] = "UserManagement";
}
@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> _UserManager
<partial name="~/Views/Shared/_Notification.cshtml">
<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationUsers[0].Name)
            </th>
            <th>
                <a asp-controller="User" asp-action="Index"
                   asp-route-sortOrder="@ViewBag.UserNameSortParam"
                   asp-route-currentFilter="@ViewBag.CurrentFilter">
                    @Html.DisplayNameFor(model => model.ApplicationUsers[0].UserName)
                </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationUsers[0].Company)
            </th>
            <th>
                Role
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationUsers[0].PhoneNumber)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ApplicationUsers)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Company.Name)
                </td>
                <td>
                    @string.Join(',',await _UserManager.GetRolesAsync(item))
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                    @Html.ActionLink("LockedOrUnlocked", "LockedOrUnlocked", new { id = item.Id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id })
                </td>
            </tr>
        }
    </tbody>
</table>
@{
    var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabled = !Model.HasNextPage ? "disabled" : "";
}

<a asp-controller="User"
   asp-action="Index"
   asp-route-sortOrder="@Model.CurrentSort"
   asp-route-pageIndex="@(Model.PageIndex - 1)"
   asp-route-currentFilter="@Model.CurrentFilter"
   class="btn btn-default @prevDisabled">
    Previous
</a>
<a asp-controller="User"
   asp-action="Index"
   asp-route-sortOrder="@Model.CurrentSort"
   asp-route-pageIndex="@(Model.PageIndex + 1)"
   asp-route-currentFilter="@Model.CurrentFilter"
   class="btn btn-default @nextDisabled">
    Next
</a>
