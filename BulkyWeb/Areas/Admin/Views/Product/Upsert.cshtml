@model ProductUpsertVM

@{
    if (Model.Product == null || Model.Product.ID == 0)
    {
        ViewData["Title"] = "Create";
        <h1>Create</h1>
    }
    else
    {
        ViewData["Title"] = "Update";
        <h1>Update</h1>
    }
    
}

<div class="row">
    <div class="col-6">
        <h4>Product</h4>
        <hr />
        <div class="row">
            <div class="col-md-4">
                <form asp-area="Admin" asp-controller="Product" asp-action="Upsert" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <input asp-for="Product.ID" hidden>
                    <div class="form-group">
                        <label asp-for="Product.Title" class="control-label"></label>
                        <input asp-for="Product.Title" class="form-control" />
                        <span asp-validation-for="Product.Title" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Product.Description" class="control-label"></label>
                        <input asp-for="Product.Description" class="form-control" />
                        <span asp-validation-for="Product.Description" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Product.ISBN" class="control-label"></label>
                        <input asp-for="Product.ISBN" class="form-control" />
                        <span asp-validation-for="Product.ISBN" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Product.Author" class="control-label"></label>
                        <input asp-for="Product.Author" class="form-control" />
                        <span asp-validation-for="Product.Author" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Product.ListPrice" class="control-label"></label>
                        <input asp-for="Product.ListPrice" class="form-control" />
                        <span asp-validation-for="Product.ListPrice" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Product.Price" class="control-label"></label>
                        <input asp-for="Product.Price" class="form-control" />
                        <span asp-validation-for="Product.Price" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Product.Price50" class="control-label"></label>
                        <input asp-for="Product.Price50" class="form-control" />
                        <span asp-validation-for="Product.Price50" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Product.Price100" class="control-label"></label>
                        <input asp-for="Product.Price100" class="form-control" />
                        <span asp-validation-for="Product.Price100" class="text-danger"></span>
                    </div>
                    <div class="form-group p-4">
                        <label asp-for="Product.CategoryID" class="control-label box-shadow d-block"></label>
                        <select asp-for="Product.CategoryID" asp-items="@Model.CategoryListItems" class="control-label">
                            <option disabled selected>--SelecteItem--</option>
                        </select>
                        <span asp-validation-for="Product.CategoryID" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="control-label">Image</label>
                        <input type="file" class="form-control" name="fileInputs" multiple/>
                    </div>
                    <div class="form-group">
                        @if (Model.Product == null || Model.Product?.ID == 0)
                        {
                            <input type="submit" value="Create" class="btn btn-primary" />
                        }
                        else
                        {
                            <input type="submit" value="Update" class="btn btn-primary" />
                        }

                    </div>
                </form>
            </div>
        </div>

        <div>
            <a asp-action="Index">Back to List</a>
        </div>
    </div>
    <div class="col-6">
        @foreach (var imgurl in Model.Product.ProductImages)
            {
                <img src="@imgurl.ImageUrl" alt="product image" width="100%" />
                <a class="btn btn-primary btn-danger" asp-action="DeleteImage" asp-route-id="@imgurl.ID">delete</a>
            }
    </div>
</div>

@section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
